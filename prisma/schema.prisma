generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  email               String          @unique
  password            String
  role                UserRole        @default(couple)
  isActive            Boolean         @default(true)
  onboardingCompleted Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  budgets             Budget[]
  guests              Guest[]
  vendors             Vendor[]
  weddingDetails      WeddingDetails?

  @@map("users")
}

model WeddingDetails {
  userId      String    @id @db.Uuid
  venue       String?
  weddingDate DateTime?
  budget      Decimal?  @db.Decimal(10, 2)
  guestCount  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wedding_details")
}

model Vendor {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String
  category     String
  priceRange   String?
  contact      String?
  website      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  status       VendorStatus?
  rating       Int?          @db.SmallInt
  isfavorite   Boolean?      @default(false)
  email        String?
  phone        String?
  address      String?
  city         String?
  tags         String[]      @default([])
  notes        String?
  quoteamount  Decimal?      @db.Decimal(10, 2)
  bookeddate   DateTime?
  instagramurl String?
  logourl      String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category], map: "vendors_userid_category_idx")
  @@index([userId, createdAt], map: "vendors_userid_createdat_idx")
  @@index([userId, status], map: "vendors_userid_status_idx")
  @@map("vendors")
}

// Public directory vendors (global, not user-scoped)
model DirectoryVendor {
  id              String   @id @default(uuid()) @db.Uuid
  ownerUserId     String?  @db.Uuid
  name            String
  category        String
  city            String?
  region          String?
  priceBand       String? // e.g., $, $$, $$$
  averageRating   Int?     @db.SmallInt
  reviewCount     Int?     @default(0)
  shortDescription String?
  description     String?
  photos          String[] @default([])
  website         String?
  // Normalized anti-abuse fields
  websiteHost     String?
  email           String?
  emailLower      String?
  phone           String?
  phoneDigits     String?
  address         String?
  latitude        Float?
  longitude       Float?
  tags            String[] @default([])
  // Anti-abuse flags
  fraudFlags      String[] @default([])
  duplicateOfId   String?  @db.Uuid
  isSuspended     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, region], map: "dirvendors_category_region_idx")
  @@index([averageRating, reviewCount], map: "dirvendors_rating_reviews_idx")
  @@index([ownerUserId], map: "dirvendors_owner_idx")
  @@index([websiteHost], map: "dirvendors_websitehost_idx")
  @@index([emailLower], map: "dirvendors_emaillower_idx")
  @@index([phoneDigits], map: "dirvendors_phonedigits_idx")
  @@map("directory_vendors")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @db.Uuid
  action      String
  targetType  String
  targetId    String
  details     Json?
  ip          String?
  ua          String?
  createdAt   DateTime @default(now())

  @@index([adminUserId, createdAt], map: "admin_audit_admin_created_idx")
  @@index([targetType, targetId, createdAt], map: "admin_audit_target_idx")
  @@map("admin_audit_logs")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  ipHash       String?
  uaHash       String?
  region       String?
  country      String?
  city         String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  revokedAt    DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastActiveAt], map: "sessions_user_lastactive_idx")
  @@index([revokedAt], map: "sessions_revoked_idx")
  @@map("sessions")
}

model DirectoryInquiry {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @db.Uuid
  name        String
  email       String
  phone       String?
  message     String
  eventDate   DateTime?
  budget      Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId, createdAt], map: "dirinquiries_vendor_created_idx")
  @@map("directory_inquiries")
}

model Guest {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  name           String
  rsvpStatus     RsvpStatus @default(pending)
  mealPreference String?
  side           Side?
  invitationSent Boolean    @default(false)
  // Phase 1 enhancements (optional, non-breaking)
  plusOneAllowed Boolean    @default(false)
  plusOneName    String?
  householdId    String?
  tags           String[]   @default([])
  relationshipCategory String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvp           RSVP?

  @@map("guests")
}

model RSVP {
  guestId       String     @id @db.Uuid
  status        RsvpStatus @default(pending)
  dateResponded DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  guest         Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("rsvps")
}

model Budget {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  category  String
  amount    Decimal      @db.Decimal(10, 2)
  allocated Decimal      @db.Decimal(10, 2)
  actual    Decimal      @default(0) @db.Decimal(10, 2)
  status    BudgetStatus @default(planned)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

enum UserRole {
  couple
  planner
  vendor
}

enum RsvpStatus {
  pending
  accepted
  declined
}

enum Side {
  bride
  groom
}

enum BudgetStatus {
  planned
  quoted
  booked
  paid
}

enum VendorStatus {
  inquiry
  shortlisted
  quoted
  booked
  contracted
  paid
}
