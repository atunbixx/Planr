# ─────────────────────────────────────────────────────────────────────────────
# Local development uses the Supabase stack in Docker: `supabase start`
# (config in supabase/config.toml; Planr runs on the +100 port range so it
# coexists with other local Supabase projects). Run `supabase status` to print
# the live values for this machine.
# ─────────────────────────────────────────────────────────────────────────────

# Database — local Supabase Postgres (Planr db port 54422)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"
# Integration tests create an ephemeral DB per run off this maintenance connection
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"

# Auth — Supabase Auth (GoTrue). Provider owns identity/sessions; our
# Organization/Membership tables own authorization. Get keys from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54421"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SECRET_KEY="sb_secret_xxx"

# Billing (Stripe) — wired live in the Billing plan
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Observability (optional)
SENTRY_DSN=""

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
